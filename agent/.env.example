# Copy to .env. Never commit .env.
# Optional: with a key the four minds think with Claude; without it they use the built-in rule-based personas.
ANTHROPIC_API_KEY=
# Chain the agents trade on (local Hardhat node by default)
RPC_URL_ARENA=http://127.0.0.1:8545
# Seconds between trading rounds
TICK_SECONDS=30
# Only for non-local chains: wallets that feed oracle prices and route fees (TESTNET ONLY)
FEEDER_PRIVATE_KEY=
TREASURY_PRIVATE_KEY=
