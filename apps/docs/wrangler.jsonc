{
  "$schema": "node_modules/wrangler/config-schema.json",
  // docs.overmind.ink: the Starlight build in ./dist, served as static assets (no worker script).
  "name": "overmind-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Served only on the custom domain, like the other Overmind workers.
  "routes": [{ "pattern": "docs.overmind.ink", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
