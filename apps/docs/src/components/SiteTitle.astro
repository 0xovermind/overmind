---
// Overmind override: the "overmind" wordmark from overmind.ink, with a dashed DOCS pill.
import logo from '../assets/logo-mark.png';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="overmind-title" aria-label="Overmind docs, home">
	<img src={logo.src} width="28" height="28" alt="" />
	<span class="word" translate="no">overmind</span>
	<span class="pill">docs</span>
</a>

<style>
	.overmind-title {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		color: var(--sl-color-white);
		min-width: 0;
	}
	img {
		width: 28px;
		height: 28px;
	}
	.word {
		font-size: 1.35rem;
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1;
	}
	.pill {
		font-family: var(--sl-font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
		border: 1px dashed var(--sl-color-gray-4);
		border-radius: 999px;
		padding: 0.2rem 0.55rem;
		margin-left: 0.2rem;
	}
</style>
